{
  "uid": "ultimate-app",
  "title": "Ultimate app",
  "tags": ["ultimate"],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(process_info, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": {
          "query": "label_values(process_info{namespace=\"$namespace\"}, app_kubernetes_io_instance)",
          "refId": "release"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p95, by route",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx share of requests",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\",status=\"5xx\"}[$__rate_interval])) / sum(rate(http_requests_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Statement p95, by operation",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (db_operation_name, le) (rate(db_client_operation_duration_seconds_bucket{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval])))",
          "legendFormat": "p95 {{db_operation_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database pool, by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (db_pool_in_use{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "in use {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (db_pool_waiting{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "waiting {{pod}}"
        },
        {
          "refId": "C",
          "expr": "sum by (pod) (db_pool_max{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "max {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Jobs per second, by queue and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, outcome) (rate(jobs_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{queue}} {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue: oldest ready job and dead letters",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (queue_oldest_ready_seconds{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "oldest {{queue}}"
        },
        {
          "refId": "B",
          "expr": "max by (queue) (queue_dead_jobs{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "dead {{queue}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Job duration p95, by queue",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (queue, le) (rate(job_duration_seconds_bucket{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Realtime: connections and dropped frames",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (connections{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "connections {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(channel_frames_dropped_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval]))",
          "legendFormat": "frames dropped/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memory: RSS over the container limit, by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (process_resident_memory_bytes{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"} / process_memory_limit_bytes{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU seconds per second, by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(process_cpu_seconds_total{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Event-loop lag p99, by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 88,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (pod, le) (rate(process_event_loop_lag_seconds_bucket{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Restarts in the last hour, by role",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app_kubernetes_io_component) (changes(process_start_time_seconds{namespace=\"$namespace\",app_kubernetes_io_instance=\"$release\"}[1h]))",
          "legendFormat": "{{app_kubernetes_io_component}}"
        }
      ]
    }
  ]
}
