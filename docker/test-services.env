# Where the suites find the services docker/docker-compose.test.yml starts — the ONE place these
# URLs are written. A laptop sources it (`set -a; . docker/test-services.env; set +a`); a CI part
# appends the lines of the services it started to $GITHUB_ENV. A suite whose URL is unset skips.
# `scripts/test-services-shape.test.ts` holds every port here to the port that compose file
# publishes. TEST_TLS_ROOT_CERT is the one path, not a URL: the CA `postgres-tls-certs` writes,
# repo-relative because every suite runs from the root.
TEST_DATABASE_URL=postgres://ultimate:ultimate@localhost:5432/postgres
TEST_REPLICATION_URL=postgres://ultimate:ultimate@localhost:5433/postgres
TEST_REDIS_URL=redis://localhost:6379
TEST_NATS_URL=nats://localhost:4222
TEST_S3_URL=http://ultimate:ultimate-test@localhost:9000/ultimate-test
TEST_TLS_REPLICATION_URL=postgres://ultimate:ultimate@localhost:5440/postgres
TEST_TLS_ROOT_CERT=docker/.tls/ca.crt
