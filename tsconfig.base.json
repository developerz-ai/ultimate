{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["bun"],

    "paths": {
      "@ultimat3/admin/dev": ["./packages/admin/src/dev/index.ts"],
      "@ultimat3/cli/serve": ["./packages/cli/src/serve-entry.ts"],
      "@ultimat3/core/page": ["./packages/core/src/page.ts"],
      "@ultimat3/entity/record": ["./packages/entity/src/record.ts"],
      "@ultimat3/query/client": ["./packages/query/src/client.ts"],
      "@ultimat3/realtime/server": ["./packages/realtime/src/server.ts"],
      "@ultimat3/render/server": ["./packages/render/src/server.ts"],
      "@ultimat3/testing/test-types": ["./packages/testing/src/test-types.ts"],
      "@ultimat3/ui/icons/*": ["./packages/ui/src/icons/glyphs/*"],
      "@ultimat3/*": ["./packages/*/src"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build", "out"]
}
