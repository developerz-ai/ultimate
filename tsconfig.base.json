{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["bun"],

    "paths": {
      "@ultimat3/admin/adapter": ["./packages/admin/src/adapter.ts"],
      "@ultimat3/admin/dev": ["./packages/admin/src/dev/index.ts"],
      "@ultimat3/admin/schema": ["./packages/admin/src/audit-schema.ts"],
      "@ultimat3/admin/error-groups": ["./packages/admin/src/error-groups.ts"],
      "@ultimat3/auth/client": ["./packages/auth/src/client.ts"],
      "@ultimat3/auth/soft-authenticator": ["./packages/auth/src/soft-authenticator.ts"],
      "@ultimat3/auth/saml-test-idp": ["./packages/auth/src/saml-test-idp.ts"],
      "@ultimat3/mail/events": ["./packages/mail/src/events.ts"],
      "@ultimat3/mcp/schema": ["./packages/mcp/src/confirmation-schema.ts"],
      "@ultimat3/pwa/client": ["./packages/pwa/src/client.ts"],
      "@ultimat3/pwa/schema": ["./packages/pwa/src/push-schema.ts"],
      "@ultimat3/cli/serve": ["./packages/cli/src/serve-entry.ts"],
      "@ultimat3/core/page": ["./packages/core/src/page.ts"],
      "@ultimat3/core/outbound": ["./packages/core/src/outbound-subpath.ts"],
      "@ultimat3/core/redis": ["./packages/core/src/redis-client.ts"],
      "@ultimat3/core/internal/error-status": ["./packages/core/src/error-status-declared.ts"],
      "@ultimat3/core/render-node": ["./packages/core/src/render-node.ts"],
      "@ultimat3/core/render-nodes": ["./packages/core/src/render-nodes.ts"],
      "@ultimat3/db/adapter": ["./packages/db/src/adapter.ts"],
      "@ultimat3/db/diagnostics": ["./packages/db/src/diagnostics-entry.ts"],
      "@ultimat3/db/schema-dump": ["./packages/db/src/schema-dump-entry.ts"],
      "@ultimat3/entity/adapter": ["./packages/entity/src/adapter.ts"],
      "@ultimat3/entity/record": ["./packages/entity/src/record.ts"],
      "@ultimat3/query/client": ["./packages/query/src/client.ts"],
      "@ultimat3/realtime/server": ["./packages/realtime/src/server.ts"],
      "@ultimat3/render/client": ["./packages/render/src/client.ts"],
      "@ultimat3/render/server": ["./packages/render/src/server.ts"],
      "@ultimat3/testing/test-types": ["./packages/testing/src/test-types.ts"],
      "@ultimat3/action/adapter": ["./packages/action/src/adapter.ts"],
      "@ultimat3/action/loader": ["./packages/action/src/loader.ts"],
      "@ultimat3/ai/adapter": ["./packages/ai/src/adapter.ts"],
      "@ultimat3/auth/adapter": ["./packages/auth/src/adapter-subpath.ts"],
      "@ultimat3/cache/adapter": ["./packages/cache/src/adapter.ts"],
      "@ultimat3/core/adapter": ["./packages/core/src/adapter.ts"],
      "@ultimat3/http/adapter": ["./packages/http/src/adapter.ts"],
      "@ultimat3/i18n/app-catalogs": ["./packages/i18n/src/app-catalogs.ts"],
      "@ultimat3/i18n/subset": ["./packages/i18n/src/subset.ts"],
      "@ultimat3/jobs/adapter": ["./packages/jobs/src/adapter.ts"],
      "@ultimat3/jobs/redis": ["./packages/jobs/src/driver-redis.ts"],
      "@ultimat3/mail/adapter": ["./packages/mail/src/adapter.ts"],
      "@ultimat3/mcp/adapter": ["./packages/mcp/src/adapter.ts"],
      "@ultimat3/manifest/docs-search": ["./packages/manifest/src/docs-search-subpath.ts"],
      "@ultimat3/notify/adapter": ["./packages/notify/src/adapter.ts"],
      "@ultimat3/pwa/adapter": ["./packages/pwa/src/adapter.ts"],
      "@ultimat3/query/adapter": ["./packages/query/src/adapter.ts"],
      "@ultimat3/query/loader": ["./packages/query/src/loader.ts"],
      "@ultimat3/realtime/adapter": ["./packages/realtime/src/adapter.ts"],
      "@ultimat3/realtime/boot": ["./packages/realtime/src/boot.ts"],
      "@ultimat3/realtime/page-runtime": ["./packages/realtime/src/page-runtime.ts"],
      "@ultimat3/realtime/page-runtime-wait": ["./packages/realtime/src/page-runtime-wait.ts"],
      "@ultimat3/realtime/sync-worker": ["./packages/realtime/src/sync-worker.ts"],
      "@ultimat3/render/adapter": ["./packages/render/src/adapter.ts"],
      "@ultimat3/render/navigation": ["./packages/render/src/navigation-entry.ts"],
      "@ultimat3/schema/adapter": ["./packages/schema/src/adapter.ts"],
      "@ultimat3/schema/sample": ["./packages/schema/src/sample.ts"],
      "@ultimat3/scraping/adapter": ["./packages/scraping/src/adapter.ts"],
      "@ultimat3/seo/adapter": ["./packages/seo/src/adapter.ts"],
      "@ultimat3/storage/adapter": ["./packages/storage/src/adapter.ts"],
      "@ultimat3/testing/conformance": ["./packages/testing/src/conformance.ts"],
      "@ultimat3/testing/preload": ["./packages/testing/src/preload.ts"],
      "@ultimat3/testing/e2e-preload": ["./packages/testing/src/e2e-preload.ts"],
      "@ultimat3/testing/registry-isolation": ["./packages/testing/src/registry-isolation.ts"],
      "@ultimat3/ui/icons/*": ["./packages/ui/src/icons/glyphs/*"],
      "@ultimat3/scraping/cdp": ["./packages/scraping/src/cdp.ts"],
      "@ultimat3/*": ["./packages/*/src"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowArbitraryExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "build", "out"]
}
