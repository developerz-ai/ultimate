{
  "name": "@ultimat3/i18n",
  "version": "31.20.0",
  "description": "Dependency-free translator, catalog flattening, locale negotiation and loud missing-key rendering",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "i18n",
    "l10n",
    "translation",
    "intl"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/I18n",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/errors.ts",
    "./src/framework.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/i18n"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./app-catalogs": "./src/app-catalogs.ts",
    "./subset": "./src/subset.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ultimat3/core": "31.20.0"
  }
}
