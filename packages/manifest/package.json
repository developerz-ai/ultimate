{
  "name": "@ultimat3/manifest",
  "version": "31.9.0",
  "description": "x.manifest.json: deterministic generated facts, contract diff, AGENTS.md budget",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "manifest",
    "openapi",
    "contract",
    "agents"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/Agents",
  "license": "MIT",
  "type": "module",
  "repository": {
