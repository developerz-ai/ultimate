  },
  "dependencies": {
    "@ultimat3/action": "31.9.0",
    "@ultimat3/core": "31.9.0",
    "@ultimat3/entity": "31.9.0",
    "@ultimat3/jobs": "31.9.0",
    "@ultimat3/query": "31.9.0",
    "@ultimat3/realtime": "31.9.0",
    "@ultimat3/schema": "31.9.0"
