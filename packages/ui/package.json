{
  "name": "@ultimat3/ui",
  "version": "22.2.2",
  "description": "SolidJS design system: semantic design tokens, dark/RTL-ready SCSS modules, a11y primitives",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/error-registry.ts",
    "./src/theme/ambient.ts",
    "**/*.scss"
  ],
  "browser": {
    "./src/theme/ambient.ts": "./src/theme/ambient.browser.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./icons/*": "./src/icons/glyphs/*.ts",
    "./jsx-probe": "./src/jsx-probe.ts",
    "./tokens": "./src/tokens/_index.scss",
    "./theme.scss": "./src/tokens/theme.scss",
    "./reset.scss": "./src/tokens/reset.scss",
    "./global.scss": "./src/global.scss"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "CATALOG.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "catalog": "bun run src/catalog/build-catalog.ts",
    "icons": "bun run src/icons/build-icons.ts"
  },
  "dependencies": {
    "@ultimat3/core": "22.2.2",
    "@ultimat3/i18n": "22.2.2",
    "@ultimat3/money": "22.2.2",
    "@ultimat3/time": "22.2.2"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
