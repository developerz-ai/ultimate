{
  "name": "@ultimat3/render",
  "version": "31.22.2",
  "description": "The route primitive and the five render modes: static, isr, ssr, stream, spa.",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "ssr",
    "ssg",
    "isr",
    "streaming",
    "solidjs"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/Routes-And-Render-Modes",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/errors.ts",
    "./src/server.ts",
    "./src/navigation-entry.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/render"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./navigation": "./src/navigation-entry.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ultimat3/cache": "31.22.2",
    "@ultimat3/core": "31.22.2",
    "@ultimat3/http": "31.22.2",
    "@ultimat3/i18n": "31.22.2",
    "@ultimat3/schema": "31.22.2",
    "@ultimat3/seo": "31.22.2",
    "sass": "1.106.1"
  }
}
