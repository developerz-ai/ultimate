{
  "name": "@ultimat3/db",
  "version": "31.19.0",
  "description": "Postgres access, transactions, migrations and drift detection",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "postgres",
    "migrations",
    "database",
    "sql"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/Entities-And-Migrations",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/db"
