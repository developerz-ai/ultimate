{
  "name": "@ultimat3/cli",
  "version": "30.6.0",
  "description": "The `x` binary: new, dev, build, verify, generate, db, mcp, doctor, deploy",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "cli",
    "generator",
    "scaffold",
    "verify",
    "mcp"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/CLI-Reference",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./serve": "./src/serve-entry.ts"
  },
  "bin": {
    "x": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "types",
    "wiki/*.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run ../../scripts/pack-cli-wiki.ts",
    "postpack": "bun run ../../scripts/pack-cli-wiki.ts --clean",
    "dev": "bun run src/bin.ts dev"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@ultimat3/action": "30.6.0",
    "@ultimat3/admin": "30.6.0",
    "@ultimat3/ai": "30.6.0",
    "@ultimat3/auth": "30.6.0",
    "@ultimat3/cache": "30.6.0",
    "@ultimat3/core": "30.6.0",
    "@ultimat3/db": "30.6.0",
    "@ultimat3/entity": "30.6.0",
    "@ultimat3/flags": "30.6.0",
    "@ultimat3/http": "30.6.0",
    "@ultimat3/i18n": "30.6.0",
    "@ultimat3/jobs": "30.6.0",
    "@ultimat3/mail": "30.6.0",
    "@ultimat3/manifest": "30.6.0",
    "@ultimat3/mcp": "30.6.0",
    "@ultimat3/money": "30.6.0",
    "@ultimat3/notify": "30.6.0",
    "@ultimat3/policy": "30.6.0",
    "@ultimat3/pwa": "30.6.0",
    "@ultimat3/query": "30.6.0",
    "@ultimat3/realtime": "30.6.0",
    "@ultimat3/render": "30.6.0",
    "@ultimat3/schema": "30.6.0",
    "@ultimat3/seo": "30.6.0",
    "@ultimat3/storage": "30.6.0",
    "@ultimat3/testing": "30.6.0",
    "@ultimat3/time": "30.6.0",
    "babel-preset-solid": "^1.9.16"
  }
}
