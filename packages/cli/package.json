{
  "name": "@ultimat3/cli",
  "version": "27.2.3",
  "description": "The `x` binary: new, dev, build, verify, generate, db, mcp, doctor, deploy",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./serve": "./src/serve-entry.ts"
  },
  "bin": {
    "x": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "types",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "dev": "bun run src/bin.ts dev"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@ultimat3/action": "27.2.3",
    "@ultimat3/admin": "27.2.3",
    "@ultimat3/ai": "27.2.3",
    "@ultimat3/auth": "27.2.3",
    "@ultimat3/cache": "27.2.3",
    "@ultimat3/core": "27.2.3",
    "@ultimat3/db": "27.2.3",
    "@ultimat3/entity": "27.2.3",
    "@ultimat3/flags": "27.2.3",
    "@ultimat3/http": "27.2.3",
    "@ultimat3/i18n": "27.2.3",
    "@ultimat3/jobs": "27.2.3",
    "@ultimat3/mail": "27.2.3",
    "@ultimat3/manifest": "27.2.3",
    "@ultimat3/mcp": "27.2.3",
    "@ultimat3/money": "27.2.3",
    "@ultimat3/notify": "27.2.3",
    "@ultimat3/policy": "27.2.3",
    "@ultimat3/pwa": "27.2.3",
    "@ultimat3/query": "27.2.3",
    "@ultimat3/realtime": "27.2.3",
    "@ultimat3/render": "27.2.3",
    "@ultimat3/schema": "27.2.3",
    "@ultimat3/seo": "27.2.3",
    "@ultimat3/storage": "27.2.3",
    "@ultimat3/testing": "27.2.3",
    "@ultimat3/time": "27.2.3",
    "babel-preset-solid": "^1.9.15"
  }
}
