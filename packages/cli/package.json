{
  "name": "@ultimat3/cli",
  "version": "24.0.0",
  "description": "The `x` binary: new, dev, build, verify, generate, db, mcp, doctor, deploy",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./serve": "./src/serve-entry.ts"
  },
  "bin": {
    "x": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "types",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "dev": "bun run src/bin.ts dev"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@ultimat3/action": "24.0.0",
    "@ultimat3/admin": "24.0.0",
    "@ultimat3/ai": "24.0.0",
    "@ultimat3/auth": "24.0.0",
    "@ultimat3/cache": "24.0.0",
    "@ultimat3/core": "24.0.0",
    "@ultimat3/db": "24.0.0",
    "@ultimat3/entity": "24.0.0",
    "@ultimat3/flags": "24.0.0",
    "@ultimat3/http": "24.0.0",
    "@ultimat3/i18n": "24.0.0",
    "@ultimat3/jobs": "24.0.0",
    "@ultimat3/mail": "24.0.0",
    "@ultimat3/manifest": "24.0.0",
    "@ultimat3/mcp": "24.0.0",
    "@ultimat3/money": "24.0.0",
    "@ultimat3/notify": "24.0.0",
    "@ultimat3/policy": "24.0.0",
    "@ultimat3/pwa": "24.0.0",
    "@ultimat3/query": "24.0.0",
    "@ultimat3/realtime": "24.0.0",
    "@ultimat3/render": "24.0.0",
    "@ultimat3/schema": "24.0.0",
    "@ultimat3/seo": "24.0.0",
    "@ultimat3/storage": "24.0.0",
    "@ultimat3/testing": "24.0.0",
    "@ultimat3/time": "24.0.0",
    "babel-preset-solid": "^1.9.15"
  }
}
