{
  "name": "@ultimat3/cli",
  "version": "7.0.0",
  "description": "The `x` binary: new, dev, build, verify, generate, db, mcp, doctor, deploy",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "x": "./src/bin.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "types",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "dev": "bun run src/bin.ts dev"
  },
  "dependencies": {
    "@babel/core": "^7.28.4",
    "@ultimat3/action": "7.0.0",
    "@ultimat3/admin": "7.0.0",
    "@ultimat3/ai": "7.0.0",
    "@ultimat3/cache": "7.0.0",
    "@ultimat3/core": "7.0.0",
    "@ultimat3/db": "7.0.0",
    "@ultimat3/entity": "7.0.0",
    "@ultimat3/http": "7.0.0",
    "@ultimat3/i18n": "7.0.0",
    "@ultimat3/jobs": "7.0.0",
    "@ultimat3/mail": "7.0.0",
    "@ultimat3/manifest": "7.0.0",
    "@ultimat3/mcp": "7.0.0",
    "@ultimat3/policy": "7.0.0",
    "@ultimat3/pwa": "7.0.0",
    "@ultimat3/query": "7.0.0",
    "@ultimat3/realtime": "7.0.0",
    "@ultimat3/render": "7.0.0",
    "@ultimat3/schema": "7.0.0",
    "@ultimat3/scraping": "7.0.0",
    "@ultimat3/seo": "7.0.0",
    "@ultimat3/storage": "7.0.0",
    "@ultimat3/testing": "7.0.0",
    "@ultimat3/time": "7.0.0",
    "babel-preset-solid": "^1.9.15"
  }
}
