{
  "name": "@ultimat3/query",
  "version": "30.7.0",
  "description": "The query primitive: a policy-checked read, optionally live, with cursor pagination and an incremental matcher",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "query",
    "live-query",
    "pagination",
    "realtime"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/Queries-And-Live-Queries",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/errors.ts",
    "./src/registry.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/query"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ultimat3/cache": "30.7.0",
    "@ultimat3/core": "30.7.0",
    "@ultimat3/db": "30.7.0",
    "@ultimat3/entity": "30.7.0",
    "@ultimat3/http": "30.7.0",
    "@ultimat3/policy": "30.7.0",
    "@ultimat3/schema": "30.7.0"
  }
}
