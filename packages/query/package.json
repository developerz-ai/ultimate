  },
  "dependencies": {
    "@ultimat3/cache": "25.1.0",
    "@ultimat3/core": "25.1.0",
    "@ultimat3/entity": "25.1.0",
    "@ultimat3/http": "25.1.0",
    "@ultimat3/policy": "25.1.0",
    "@ultimat3/schema": "25.1.0"
  }
