{
  "name": "@ultimat3/testing",
  "version": "30.3.0",
  "description": "Test harness: cloned template DBs per worker, frozen clock, sealed network, 6 test types",
  "keywords": [
    "ultimate",
    "bun",
    "framework",
    "testing",
    "test",
    "fixtures",
    "harness"
  ],
  "homepage": "https://github.com/developerz-ai/ultimate/wiki/Testing",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerz-ai/ultimate.git",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./preload": "./src/preload.ts",
    "./e2e-preload": "./src/e2e-preload.ts",
    "./registry-isolation": "./src/registry-isolation.ts",
    "./test-types": "./src/test-types.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*-fixture.ts",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@ultimat3/action": "30.3.0",
    "@ultimat3/cache": "30.3.0",
    "@ultimat3/core": "30.3.0",
    "@ultimat3/db": "30.3.0",
    "@ultimat3/entity": "30.3.0",
    "@ultimat3/http": "30.3.0",
    "@ultimat3/i18n": "30.3.0",
    "@ultimat3/jobs": "30.3.0",
    "@ultimat3/mail": "30.3.0",
    "@ultimat3/policy": "30.3.0",
    "@ultimat3/pwa": "30.3.0",
    "@ultimat3/query": "30.3.0",
    "@ultimat3/realtime": "30.3.0",
    "@ultimat3/render": "30.3.0",
    "@ultimat3/schema": "30.3.0",
    "@ultimat3/time": "30.3.0"
  }
}
