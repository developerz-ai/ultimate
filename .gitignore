# Bun / Node
node_modules/
.bun/
bun.lockb.tmp

# Env. Ignore every .env variant and un-ignore the one committed template, rather than listing the
# variants: the list was `.env`, `.env.local`, `.env.*.local`, `.env.test.local`, `.env.dev`, and
# `.env.production` — the file docker-compose.prod.yml reads real production secrets from — matched
# none of them. A deny-list of secret filenames is wrong by construction; the next name nobody
# thought of is committed in plaintext.
.env
.env.*
!.env.example

# Build artifacts
dist/
build/
out/
*.tsbuildinfo
.turbo/
.solid/
.output/
.x/

# tsc emit alongside TS source (Bun runs .ts directly; these are stray)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.jsx
packages/*/src/**/*.jsx.map

# Task-master local state
.claude-task-master/
.ai-task-master/

# CodeGraph index
.codegraph/

# Tests / coverage
coverage/
.nyc_output/
**/playwright-report/
**/test-results/
**/.last-run.json
.lighthouseci/

# Logs
*.log
npm-debug.log*
# ...except a published benchmark's own transcript: the docs quote its numbers as a measured
# result, and the run that produced them is the evidence for that claim.
!scripts/bench/results/*.log

# IDE — editor config is operator-local, never committed
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude local
.claude/settings.local.json
.claude/.local/
.claude/worktrees/

# Operator-local MCP config (may carry API keys / local ports).
# The committed *.example.json files document the shape.
/.mcp.json
/.ui-debugger-mcp.json

# Temp
tmp/
temp/
.tmp/
.debugging/
.playwright-mcp/
/*.png

# Hand-written ambient declarations must survive the stale-emit cleanup above.
!packages/ui/src/scss.d.ts

# Generated site output
site/dist/

# CLI test fixtures: `<base>/run-<pid>/`, written and removed per run (`process-root-fixture.ts`).
# A crashed run leaves its root until the next run under that base reaps it. One pattern rather
# than one line per base: 36 bases had no line, and a new one would need its own to stay out.
packages/cli/.*-fixture/
packages/testing/.isolated-plugins-fixture/
# `version.test.ts` writes these beside itself and deletes them in a `finally` a crash skips.
packages/core/src/.version-fixture-*.json

# Scratch credential files. A mis-set path once wrote an npm session token into the repo root.
.npmrc-login
# And the file that incident was aiming at. No `.npmrc` is tracked anywhere in this repo — releases
# authenticate over OIDC and need none — so any that appears is a local credential.
.npmrc
undefined/
.serve-fixture/
.dev-hold-fixture/
.error-pages-fixture/
.live-routes-fixture/
.roles-error-page-fixture/

# Test TLS material `postgres-tls-certs` writes (docker/docker-compose.test.yml), private key included.
docker/.tls/
