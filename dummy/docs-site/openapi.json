            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "issues": {
            "items": {
              "properties": {
                "expected": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "params": {
                  "type": "object"
                },
                "path": {
                  "type": "string"
                },
                "received": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                }
              },
              "required": [
                "path",
