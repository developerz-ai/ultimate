          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "policy denied"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "X_BODY_INVALID"
          }
        },
        "summary": "Readiness of this process",
        "tags": [
          "healths"
        ],
        "x-ultimate": {
          "capability": "public",
          "idempotent": false,
          "invalidates": [],
