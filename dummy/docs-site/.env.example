# Generated from defineEnv() — regenerate with `x env example`. Never hand-edited: drift
# fails `x verify`.
# Commit this file. Never commit .env: Bun loads .env, .env.<mode> and .env.local for you.

# Postgres URL. Empty means embedded: x dev runs PGlite in-process.
# optional · url
DATABASE_URL=

# HTTP port this role binds. Every PaaS injects it.
# required · port
PORT=3000

# Realtime fan-out cluster. Only the sync role is asked for it.
# optional · url · role sync
NATS_URL=

# Public origin of the pages. Sync admits sockets from it.
# optional · url · role web/sync
APP_URL=

# Where a page dials the sync socket. Compose: ws://<host>:3001/_x/sync
# optional · string · role web
SYNC_URL=

# Session cookie signing key. Generate: openssl rand -hex 32
# optional · string · secret
SESSION_SECRET=

# --- Framework ---------------------------------------------------------------
# Required outside development/test, whatever envSchema declares. Generate each with
# `openssl rand -hex 32`; `x env check` and `x doctor` report one that is missing.

# Signs pagination cursors. Unset, every role refuses to boot (X_CURSOR_SECRET_DEV).
# required when deployed · string · secret
ULTIMATE_CURSOR_SECRET=

# Signs upload grants on the embedded disk. Unset, every role refuses to boot (X_ENV_MISSING).
# Not read when S3_ENDPOINT and S3_BUCKET select object storage.
# required when deployed · string · secret
STORAGE_SIGNING_SECRET=
