              "x-ultimate-refinements": [
                {
                  "name": "mail-address",
                  "message": "a mailbox or a display-form address, with no control character or non-ASCII mailbox"
                }
              ]
            }
          },
          "unsubscribeUrl": {
            "type": "string",
