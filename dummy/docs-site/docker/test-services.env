# Where the suites find the services docker/docker-compose.test.yml starts — the one place these URLs are
# written. A laptop sources it (`set -a; . docker/test-services.env; set +a`); CI appends it to $GITHUB_ENV.
# TEST_DATABASE_URL is what @ultimat3/testing clones one database per test worker from.
TEST_DATABASE_URL=postgres://docs-site:docs-site-test@127.0.0.1:55432/postgres
TEST_REDIS_URL=redis://127.0.0.1:56379
TEST_NATS_URL=nats://127.0.0.1:54222
TEST_S3_URL=http://docs-site:docs-site-test@127.0.0.1:59000/docs-site-test
