# The demo's image, built from the FRAMEWORK REPO ROOT as context.
#
# `docker/Dockerfile` beside this one is the real one — the self-contained image a user's app gets
# from `x new`, which copies its own `package.json` + `bun.lock` and resolves `@ultimat3/*` from
# npm. This demo cannot use it: it lives inside the framework monorepo and links the framework
# packages through workspace symlinks, so its dependencies are the repo, not a registry. Building
# it from its own directory would resolve `@ultimat3/*` to the last published version and silently
# test the wrong framework.
#
# Build from the repo root:
#   docker build -f dummy/social-media-clone/docker/Dockerfile.monorepo \
#     --build-arg BUILD_ID=$(git rev-parse --short HEAD) -t ultimate-social:dev .
#
# This file goes away the moment the framework's breaking changes are published — at that point the
# demo is an ordinary consumer and `docker/Dockerfile` applies.
#
# syntax=docker/dockerfile:1

# ---------- deps ----------
# The whole tree, not a subset. `bun.lock` describes EVERY workspace member, so a partial copy
# makes `--frozen-lockfile` refuse: bun sees members it cannot resolve and wants to rewrite the
# lockfile it was told not to touch. Copying only what this app imports looked tidier and failed
# with "lockfile had changes, but lockfile is frozen" — the lockfile is a property of the repo,
# not of one app inside it. `.dockerignore` is what keeps this cheap.
FROM oven/bun:1.3-alpine AS deps
WORKDIR /repo
COPY . .
RUN bun install --frozen-lockfile

# ---------- runtime ----------
# No build stage: `x verify` is the gate and it runs in CI, before this image is ever built. A
# second gate here would be a slower copy of one that already passed.
FROM oven/bun:1.3-alpine AS runtime
WORKDIR /repo

COPY --from=deps /repo /repo

WORKDIR /repo/dummy/social-media-clone

# Stamped by CI from the git sha. It namespaces every service-worker cache, drives version-skew
# detection, and tags every reported error with the commit that caused it. Never `latest`.
ARG BUILD_ID=
ENV NODE_ENV=production \
    ROLE=web \
    PORT=3000 \
    METRICS_PORT=9090 \
    BUILD_ID=${BUILD_ID}

EXPOSE 3000 9090

# `/readyz`, not `/healthz`: liveness only asks whether the process is up, readiness asks whether it
# should receive traffic. Draining is the case that matters, and only readiness reports it.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 CMD \
  bun --eval "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"

# The framework mkdirs `.x/` at boot for any service left embedded, so it must be writable by the
# runtime user before the drop — under a read-only root filesystem this is what keeps boot working.
RUN mkdir -p /repo/dummy/social-media-clone/.x && chown -R bun:bun /repo/dummy/social-media-clone/.x

USER bun

# No CMD: ROLE selects behaviour, so there are no argv variants to get wrong, and a manifest that
# sets no `args:` gets the right process.
ENTRYPOINT ["bun", "apps/web/server.ts"]
