# Generated from defineEnv() — regenerate with `x env example`. Never hand-edited: drift
# fails `x verify`.
# Commit this file. Never commit .env: Bun loads .env, .env.<mode> and .env.local for you.

# unset = embedded PGlite
# optional · url
DATABASE_URL=

# optional · url · secret · role web/sync/worker/replicator
NATS_URL=

# required · port
PORT=3000

# required · port
METRICS_PORT=9090

# optional · string
BUILD_ID=

# absolute origin; required when ULTIMATE_ENV/NODE_ENV is production
# optional · url
APP_URL=

# unset = local disk under .x/storage
# optional · url
S3_ENDPOINT=

# optional · string
S3_BUCKET=

# optional · string · secret
S3_ACCESS_KEY_ID=

# optional · string · secret
S3_SECRET_ACCESS_KEY=

# optional · url
MEDIA_PUBLIC_BASE_URL=

# optional · string
HCAPTCHA_SITE_KEY=

# optional · string · secret
HCAPTCHA_SECRET=

# optional · string
SENTRY_DSN=

# The audited read-only database gateway. The agent never holds a DATABASE_URL.
# optional · url
DB_GATEWAY_URL=

# The error monitor's MCP endpoint: errors as a work queue.
# optional · url
ERROR_MONITOR_MCP_URL=

# Bearer token for this app's own MCP server at APP_URL/mcp.
# optional · string · secret
APP_MCP_TOKEN=

# --- Framework ---------------------------------------------------------------
# Required outside development/test, whatever envSchema declares. Generate each with
# `openssl rand -hex 32`; `x env check` and `x doctor` report one that is missing.

# Signs pagination cursors. Unset, every role refuses to boot (X_CURSOR_SECRET_DEV).
# required when deployed · string · secret
ULTIMATE_CURSOR_SECRET=

# Signs upload grants on the embedded disk. Unset, every role refuses to boot (X_ENV_MISSING).
# Not read when S3_ENDPOINT and S3_BUCKET select object storage.
# required when deployed · string · secret
STORAGE_SIGNING_SECRET=
