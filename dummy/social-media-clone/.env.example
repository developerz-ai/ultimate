# Every key this app reads, with a safe placeholder. Never a real secret — this file is committed.
# `x dev` needs none of it: unset means embedded (PGlite, in-process events, local disk storage).
#
# A new runtime variable ships with its line here in the SAME change that reads it. An env var is
# a contract; a key that only exists in someone's shell is a boot failure waiting for a deploy.

# --- Core -------------------------------------------------------------------
# Empty means embedded. In production these are supplied by the platform.
DATABASE_URL=
NATS_URL=
PORT=3000
ROLE=web
# Which port /metrics binds. NOT moved by `x dev --port` — set it explicitly to run two apps.
METRICS_PORT=9090
# Stamped by CI from the git sha. Drives cache namespacing, version-skew detection and the
# release tag on every reported error. Unset falls back to `dev`.
BUILD_ID=
# Absolute origin of this app. The typed client has no origin without it and fails the call.
APP_URL=http://localhost:3000

# --- Object storage (S3 API; R2 in production) ------------------------------
# Unset means the local disk driver under .x/storage — a real S3 surface, no credentials.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base for user media. Non-secret by design.
MEDIA_PUBLIC_BASE_URL=

# --- Anti-bot ---------------------------------------------------------------
# The site key is public and ships to the browser; the secret is server-only and never bundled.
# Unset selects the null verifier, so signup and login work locally with no keys.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# --- Error monitoring -------------------------------------------------------
# A DSN is a public ingest key, not a credential. Unset OR blank disables reporting entirely,
# which is the default for dev and every test — a blank value is what an empty ConfigMap key
# looks like, and it must not read as "enabled but broken".
ERROR_MONITOR_DSN=

# --- Agent reach (consumed by .mcp.json, not by the app) --------------------
# The audited read-only database gateway. The agent never holds a DATABASE_URL.
DB_GATEWAY_URL=
# The error monitor's MCP endpoint — errors as a work queue.
ERROR_MONITOR_MCP_URL=
# Bearer token for this app's own MCP server at ${APP_URL}/mcp.
APP_MCP_TOKEN=
