{
  "name": "social-media-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun bin/setup.ts",
    "dev": "x dev",
    "verify": "x verify",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "test": "bun test --isolate",
    "db:migrate": "x db migrate",
    "db:seed": "bun run packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electric-sql/pglite": "^0.5.11",
    "@types/bun": "1.4.4",
    "@ultimat3/scraping": "31.4.1",
    "@ultimat3/testing": "31.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ultimat3/action": "31.4.1",
    "@ultimat3/admin": "31.4.1",
    "@ultimat3/auth": "31.4.1",
    "@ultimat3/cache": "31.4.1",
    "@ultimat3/cli": "31.4.1",
    "@ultimat3/core": "31.4.1",
    "@ultimat3/db": "31.4.1",
    "@ultimat3/entity": "31.4.1",
    "@ultimat3/http": "31.4.1",
    "@ultimat3/i18n": "31.4.1",
    "@ultimat3/jobs": "31.4.1",
    "@ultimat3/mcp": "31.4.1",
    "@ultimat3/policy": "31.4.1",
    "@ultimat3/pwa": "31.4.1",
    "@ultimat3/query": "31.4.1",
    "@ultimat3/realtime": "31.4.1",
    "@ultimat3/render": "31.4.1",
    "@ultimat3/ui": "31.4.1",
    "solid-js": "1.9.17"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
