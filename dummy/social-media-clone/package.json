{
  "name": "social-media-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bin/setup",
    "dev": "x dev",
    "check": "bin/check",
    "verify": "x verify",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "test": "bun test",
    "db:migrate": "x db migrate",
    "db:seed": "bun run packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.1",
    "@ultimat3/testing": "20.2.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ultimat3/action": "20.2.1",
    "@ultimat3/admin": "20.2.1",
    "@ultimat3/cache": "20.2.1",
    "@ultimat3/cli": "20.2.1",
    "@ultimat3/core": "20.2.1",
    "@ultimat3/db": "20.2.1",
    "@ultimat3/entity": "20.2.1",
    "@ultimat3/http": "20.2.1",
    "@ultimat3/i18n": "20.2.1",
    "@ultimat3/jobs": "20.2.1",
    "@ultimat3/mcp": "20.2.1",
    "@ultimat3/policy": "20.2.1",
    "@ultimat3/pwa": "20.2.1",
    "@ultimat3/query": "20.2.1",
    "@ultimat3/realtime": "20.2.1",
    "@ultimat3/render": "20.2.1",
    "@ultimat3/ui": "20.2.1",
    "solid-js": "1.9.15"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
