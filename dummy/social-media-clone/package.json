{
  "name": "social-media-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun bin/setup.ts",
    "dev": "x dev",
    "check": "bun bin/check.ts",
    "verify": "x verify",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "test": "bun test --isolate",
    "db:migrate": "x db migrate",
    "db:seed": "bun run packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "1.4.2",
    "@ultimat3/testing": "25.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ultimat3/action": "25.0.0",
    "@ultimat3/admin": "25.0.0",
    "@ultimat3/cache": "25.0.0",
    "@ultimat3/cli": "25.0.0",
    "@ultimat3/core": "25.0.0",
    "@ultimat3/db": "25.0.0",
    "@ultimat3/entity": "25.0.0",
    "@ultimat3/http": "25.0.0",
    "@ultimat3/i18n": "25.0.0",
    "@ultimat3/jobs": "25.0.0",
    "@ultimat3/mcp": "25.0.0",
    "@ultimat3/policy": "25.0.0",
    "@ultimat3/pwa": "25.0.0",
    "@ultimat3/query": "25.0.0",
    "@ultimat3/realtime": "25.0.0",
    "@ultimat3/render": "25.0.0",
    "@ultimat3/ui": "25.0.0",
    "solid-js": "1.9.15"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
