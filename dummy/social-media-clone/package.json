{
  "name": "social-media-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bin/setup",
    "dev": "x dev",
    "check": "bin/check",
    "verify": "x verify",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "test": "bun test",
    "db:migrate": "x db migrate",
    "db:seed": "bun run packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@electric-sql/pglite": "^0.5.4",
    "@types/bun": "^1.4.0",
    "@ultimat3/testing": "17.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ultimat3/action": "17.0.0",
    "@ultimat3/admin": "17.0.0",
    "@ultimat3/cache": "17.0.0",
    "@ultimat3/cli": "17.0.0",
    "@ultimat3/core": "17.0.0",
    "@ultimat3/db": "17.0.0",
    "@ultimat3/entity": "17.0.0",
    "@ultimat3/http": "17.0.0",
    "@ultimat3/i18n": "17.0.0",
    "@ultimat3/jobs": "17.0.0",
    "@ultimat3/mcp": "17.0.0",
    "@ultimat3/policy": "17.0.0",
    "@ultimat3/pwa": "17.0.0",
    "@ultimat3/query": "17.0.0",
    "@ultimat3/realtime": "17.0.0",
    "@ultimat3/render": "17.0.0",
    "@ultimat3/ui": "17.0.0",
    "solid-js": "1.9.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
