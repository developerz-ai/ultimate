{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run verify)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run boundaries)",
      "Bash(bun run manifest)",
      "Bash(bun run workspaces:list)",
      "Bash(bun run schema-dumps --check:*)",
      "Bash(bun test:*)",
      "Bash(bun run x -- :*)",
      "Bash(bun run scripts/*.ts --check)",
      "Bash(bun run scripts/*.ts --check --json)",
      "Bash(bun run scripts/*.ts --json --check)",
      "Bash(bun run scripts/release.ts --check:*)",
      "Bash(bun run scripts/list-workspaces.ts --json)",
      "Bash(bun run scripts/release-workflow.ts --json)",
      "Bash(bun run scripts/registry-audit.ts --json)",
      "Bash(bun run scripts/release-due.ts --json)",
      "Bash(bun run scripts/claude-md-size.ts --json)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git stash list:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(npm view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr list:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose -f docker/docker-compose.test.yml ps:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.ts",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snapshot-tree.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive-git.sh"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-test-path.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-drift.ts",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
