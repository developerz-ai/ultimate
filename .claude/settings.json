{
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run verify)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run boundaries)",
      "Bash(bun run manifest)",
      "Bash(bun run workspaces:list)",
      "Bash(bun test:*)",
      "Bash(bun run x -- :*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr list:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_FILE_PATHS\" ] && bunx biome check --no-errors-on-unmatched --write \"$CLAUDE_FILE_PATHS\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snapshot-tree.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive-git.sh"
          }
        ]
      }
    ]
  }
}
