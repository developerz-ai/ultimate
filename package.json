{
  "name": "@ultimat3/root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*/apps/*",
    "examples/*/packages/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "bun run --filter @ultimat3/cli dev",
    "typecheck": "tsc -b --pretty",
    "typecheck:clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test --path-ignore-patterns='**/dist/**' --path-ignore-patterns='**/e2e/**'",
    "test:watch": "bun test --watch --path-ignore-patterns='**/dist/**'",
    "verify": "bun run scripts/verify.ts",
    "boundaries": "bun run scripts/boundaries.ts",
    "manifest": "bun run scripts/manifest.ts",
    "workspaces:list": "bun run scripts/list-workspaces.ts",
    "x": "bun run packages/cli/src/bin.ts"
  },
  "bin": {
    "x": "./packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "^1.3.14",
    "lefthook": "^1.10.0",
    "solid-js": "^2.0.0-beta.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
