  "jobs": [
    {
      "name": "deliverDigest",
      "file": "apps/web/app/digest/jobs.ts",
      "queue": "mail",
      "idempotencyKey": "digest:{memberId}:{localDate}",
      "steps": ["load-member", "load-posts", "send"],
      "retry": {
        "attempts": 4,
        "backoff": "exponential"
      },
      "concurrency": {
        "key": "memberId",
        "limit": 1
      }
    },
    {
      "name": "notifySubscribers",
      "file": "apps/web/app/posts/jobs.ts",
      "queue": "mail",
      "idempotencyKey": "notify:{postId}",
      "steps": ["load-post", "announce", "load-recipients", "send"],
      "retry": {
        "attempts": 5,
        "backoff": "exponential"
      },
      "concurrency": {
        "key": "postId",
        "limit": 1
      }
    },
    {
      "name": "onboardOrg",
      "file": "apps/web/app/orgs/jobs.ts",
      "queue": "default",
      "idempotencyKey": "onboard:{orgId}",
      "steps": ["provision", "welcome-email", "sleep:3d", "nudge"],
      "retry": {
        "attempts": 5,
        "backoff": "exponential"
      }
    },
    {
      "name": "sendDigest",
      "file": "apps/web/app/digest/jobs.ts",
      "queue": "digest",
      "idempotencyKey": "digest:{runDate}",
      "steps": ["load-recipients", "schedule:{zone}"],
      "retry": {
        "attempts": 3,
        "backoff": "exponential"
      }
    },
    {
      "name": "sendInvite",
      "file": "apps/web/app/orgs/jobs.ts",
      "queue": "mail",
      "idempotencyKey": "invite:{memberId}",
      "steps": ["load-member", "send"],
      "retry": {
        "attempts": 3,
        "backoff": "exponential"
      }
    }
  ],
