{
  "openapi": "3.1.0",
  "info": {
    "title": "Billing vendor",
    "version": "2026-11-01"
  },
  "paths": {
    "/v1/prices": {
      "get": {
        "operationId": "listPrices",
        "summary": "One page of the price catalog, oldest first",
        "tags": ["catalog"],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "a page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceList"
                }
              }
            }
          },
          "429": {
            "description": "rate limited"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PriceList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Price"
            }
          },
          "next_cursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "next_cursor"]
      },
      "Price": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "plan": {
            "type": "string",
            "enum": ["free", "team", "business"]
          },
          "currency": {
            "type": "string",
            "enum": ["USD", "EUR"]
          },
          "unit_amount": {
            "type": "integer",
            "minimum": 0
          },
          "seats": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["seq", "plan", "currency", "unit_amount", "seats"]
      }
    }
  }
}
