# Postly environment. `bin/setup` copies this to `.env`; `x dev` fills the local defaults.
# Every var here is declared in `app.config.ts` under `env` and validated at boot —
# a missing or malformed value fails startup with X_ENV_INVALID, never a 500 in traffic.
# No secrets in this file, ever. Real values come from the deployment's secret store.

# Public origin. Canonical URLs, OG images, sitemap, and hreflang are derived from it.
APP_URL=http://localhost:3000

# Postgres. `x dev` starts an embedded instance and points here automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postly_dev

# NATS, for live-query fanout and cross-instance cache invalidation.
# `x dev` runs an in-process server; prod points at the cluster.
NATS_URL=nats://localhost:4222

# Redis (cache tier 3). Required in prod: ISR regeneration happens on a different
# instance than the write, so tier 2 (in-process LRU) is not enough on its own.
REDIS_URL=redis://localhost:6379

# Session signing key. >= 32 chars. Rotate by adding the new key first, then removing the old.
SESSION_SECRET=dev-only-session-secret-change-me-32

# Transactional mail (digest, invites, onboarding). `x dev` captures mail in /_x instead of sending.
MAIL_API_KEY=

# Model provider for the post-summary prompt. Unset in dev disables the summarize action;
# its eval suite runs against recorded fixtures and does not need a key.
ANTHROPIC_API_KEY=

# Which process this container is. One image, N roles.
# web | sync | worker | scheduler | migrate | replicator
ROLE=web

# debug | info | warn | error
LOG_LEVEL=info
