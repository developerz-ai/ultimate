{
  "name": "@postly/root",
  "version": "0.0.1",
  "private": true,
  "description": "Postly \u2014 the Ultimate reference application",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "setup": "bun bin/setup.ts",
    "dev": "x dev",
    "check": "bun bin/check.ts",
    "build": "x build",
    "typecheck": "tsc -p . --pretty",
    "test": "bun test --isolate",
    "db:gen": "x db gen",
    "db:migrate": "x db migrate",
    "db:seed": "x db seed dev",
    "manifest": "x manifest --json"
  },
  "devDependencies": {
    "@ultimat3/cache": "25.1.0",
    "@ultimat3/entity": "25.1.0",
    "@ultimat3/testing": "25.1.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ultimat3/cli": "25.1.0",
    "@ultimat3/core": "25.1.0"
  }
}
