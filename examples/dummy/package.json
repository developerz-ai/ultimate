{
  "name": "@postly/root",
  "version": "0.0.1",
  "private": true,
  "description": "Postly \u2014 the Ultimate reference application",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bin/setup",
    "dev": "bin/dev",
    "check": "bin/check",
    "build": "x build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:gen": "x db gen",
    "db:migrate": "x db migrate",
    "db:seed": "x db seed dev",
    "manifest": "x manifest --json"
  },
  "devDependencies": {
    "@ultimat3/entity": "1.2.0",
    "@ultimat3/testing": "1.2.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@ultimat3/cli": "1.2.0",
    "@ultimat3/core": "1.2.0"
  }
}
